[Unit]
Description=Pantry API (Fastify)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User={{ app_user }}
Group={{ app_group }}
WorkingDirectory={{ app_root }}/current/api
EnvironmentFile={{ secrets_dir }}/api.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node {{ app_root }}/current/api/dist/server.js
# Restart-only (amendment 2): no ExecReload. `systemctl restart` sends SIGTERM
# and the process drains in-flight requests inside TimeoutStopSec=30 before
# SIGKILL. `systemctl reload` would be a silent no-op for Type=simple.
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:/var/log/pantry/api.log
StandardError=append:/var/log/pantry/api.log

# Pinned explicitly rather than left to whatever systemd's own default
# happens to be: display.webp/thumb.webp files this process writes at
# runtime under public/products/ need their group-read bit set for nginx
# (via that tree's setgid group=www-data) to serve them at all — 0022
# yields mode 0644 on new files. A future hardening pass tightening this
# unit's other directives could otherwise silently flip the effective umask
# to something more restrictive and 403 CDN content with no obvious cause
# (reviewer-p7 R5).
UMask=0022

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Media root (private/public/quarantine trees) is provisioned by the app
# role's directory tasks, ahead of this unit ever starting — ProtectSystem=strict
# denies writes everywhere except the paths listed here.
ReadWritePaths=/var/log/pantry {{ media_root }}
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target

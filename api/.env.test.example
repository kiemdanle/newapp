NODE_ENV=test
PORT=4100
HOST=127.0.0.1
LOG_LEVEL=silent
DATABASE_URL=postgresql://pantry:pantry@localhost:5432/pantry_test?schema=public
# Placeholder shared index (db15) — every developer/CI job overrides this with
# their own isolated DB index via TEST_REDIS_URL (see tests/helpers/env.ts); tests
# flush this DB before every test, so never point it at a shared/live Redis.
REDIS_URL=redis://localhost:6379/15
JWT_ACCESS_SECRET=test-secret-32-bytes-aaaaaaaaaaa
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=pantry-api
JWT_AUDIENCE=pantry-app
REFRESH_TOKEN_TTL_DAYS=30
TOTP_ENCRYPTION_KEY=dGVzdC1rZXktMzItYnl0ZXMtZm9yLXRvdHAtYWVzZ2M=
# Rate limiter stays ON in tests. The global per-user/per-IP budgets are set high
# so they don't interfere with multi-request test flows, while the /v1/auth/* per-IP
# budget is kept low so a dedicated test can assert it actually triggers.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_USER_PER_MIN=1000
RATE_LIMIT_PER_IP_PER_MIN=1000
RATE_LIMIT_AUTH_PER_IP_PER_MIN=30
GOOGLE_CLIENT_ID=test-google-client-id
APPLE_CLIENT_ID=test-apple-client-id
APPLE_TEAM_ID=TESTTEAM
APPLE_KEY_ID=TESTKEY
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Expyrico-Test
WEBAUTHN_ORIGIN=http://localhost
ANDROID_PACKAGE_NAME=com.expyrico.app
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=test@pantry.local
APP_DEEP_LINK=expyrico://
ADMIN_URL=http://localhost:3000
COUNTRY_DETECT_PRIMARY=https://ipapi.co
COUNTRY_DETECT_FALLBACK=http://ip-api.com
FIREBASE_PROJECT_ID=expyrico-test
FIREBASE_CREDENTIAL_MODE=workload_identity
# Product media (Phase 3): /tmp always exists/writable in dev+CI. Tests that assert
# real file writes/cleanup override MEDIA_ROOT per-test to an isolated temp dir.
MEDIA_ROOT=/tmp
MEDIA_PUBLIC_BASE_URL=https://media.expyrico.test
# reCAPTCHA Enterprise (Phase 7): dummy project/site keys — no test ever calls
# the real Google API (the assessment client is injectable), but config parsing
# requires these fields to be present so a fresh clone/CI can boot at all
# (reviewer-p7 I4: this file, unlike the gitignored .env.test, was never
# updated when config.ts made them required).
RECAPTCHA_PROJECT_ID=expyrico-test
RECAPTCHA_SITE_KEY_ANDROID=test-recaptcha-site-key-android
RECAPTCHA_SITE_KEY_IOS=test-recaptcha-site-key-ios

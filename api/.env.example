NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgresql://pantry:pantry@localhost:5432/pantry?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-32-bytes-minimum-aaaaaaa
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=pantry-api
JWT_AUDIENCE=pantry-app
REFRESH_TOKEN_TTL_DAYS=30
TOTP_ENCRYPTION_KEY=change-me-32-bytes-base64

# Rate limiting (per 1-minute window)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_USER_PER_MIN=60
RATE_LIMIT_PER_IP_PER_MIN=30
RATE_LIMIT_AUTH_PER_IP_PER_MIN=10

# OAuth
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# WebAuthn
# WEBAUTHN_RP_ID must be a real domain that serves Digital Asset Links / AASA
# (for production: typically the public API host, e.g. api.example.com).
# `localhost` only works for browser WebAuthn on the same machine — Android/
# iOS platform passkeys reject it.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Expyrico
WEBAUTHN_ORIGIN=http://localhost:8081
# Optional comma-separated extra origins accepted at verify time.
# Android native: android:apk-key-hash:<base64url-sha256-of-signing-cert>
# WEBAUTHN_ADDITIONAL_ORIGINS=android:apk-key-hash:REPLACE_ME
# Optional: publish /.well-known/assetlinks.json from the API for Android passkeys
ANDROID_PACKAGE_NAME=com.expyrico.app
# ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:...

# SMTP (for verification + reset emails)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pantry <no-reply@pantry.local>"

# Frontend URLs (used in email links)
APP_DEEP_LINK=expyrico://
# Must be an origin only: no path, query, fragment, or credentials. Production
# requires HTTPS; mobile MOBILE_ADMIN_URL must use the same production origin.
ADMIN_URL=http://localhost:4001
# Required in production and must equal ADMIN_URL after origin normalization.
MOBILE_ADMIN_URL=http://localhost:4001

# Country detection
COUNTRY_DETECT_PRIMARY=https://ipapi.co
COUNTRY_DETECT_FALLBACK=http://ip-api.com

# Firebase Cloud Messaging — project ID is public; runtime credentials use ADC.
# service_account_file requires GOOGLE_APPLICATION_CREDENTIALS to point at an ignored JSON file.
FIREBASE_PROJECT_ID=expyrico-example
FIREBASE_CREDENTIAL_MODE=workload_identity
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

# Product media (Phase 3) — filesystem root for private/public/quarantine
# trees, provisioned by infra's app role before the API ever starts, and the
# public base URL the CDN vhost (Phase 7) serves `public/` from.
MEDIA_ROOT=/tmp/expyrico-media
MEDIA_PUBLIC_BASE_URL=http://localhost:8080

# reCAPTCHA Enterprise (Phase 7) — server-side submit_product assessment.
# Android and iOS each require their own registered site key.
RECAPTCHA_PROJECT_ID=expyrico-example
RECAPTCHA_SITE_KEY_ANDROID=replace-with-android-site-key
RECAPTCHA_SITE_KEY_IOS=replace-with-ios-site-key
# RECAPTCHA_MIN_SCORE=0.5
# RECAPTCHA_ASSESSMENT_TIMEOUT_MS=5000

# product_creation rollout mode (Phase 7) — off|internal|all. Setting itself
# is DB-managed (admin settings UI); this only configures the `internal`
# cohort's environment-managed allowlist.
# PRODUCT_CREATION_INTERNAL_ALLOWLIST=11111111-1111-1111-1111-111111111111,22222222-2222-2222-2222-222222222222
# PRODUCT_CREATION_MAX_ACTIVE_DRAFTS_PER_USER=20
# PRODUCT_CREATION_MAX_DAILY_BYTES_PER_USER=209715200

# Operational health thresholds (Phase 7) — every one env-overridable with
# the spec's numbers as defaults; see infra/README.md "Operational health".
# HEALTH_FREE_DISK_WARNING_PERCENT=20
# HEALTH_FREE_DISK_HARD_STOP_PERCENT=15
# HEALTH_PENDING_OLDEST_WARNING_HOURS=24
# HEALTH_CLEANUP_STALE_HOURS=26
# HEALTH_BACKUP_STALE_HOURS=26
# HEALTH_ASSESSMENT_FAILURE_RATE_PERCENT=5
# HEALTH_API_5XX_RATE_PERCENT=2
# HEALTH_UPLOAD_REJECTION_RATE_PERCENT=25

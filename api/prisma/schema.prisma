generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum UserStatus {
  active
  suspended
  deleted
}

enum ThemePreference {
  expyrico
  bento
  clay
  material
}

enum ReviewStatus {
  visible
  hidden
  deleted

  @@map("review_status")
}

enum ReviewRating {
  buy_again
  buy_again_on_sale
  wont_buy

  @@map("review_rating")
}

enum ReportTargetType {
  review
  user
  product
  deal
  giveaway
}

enum ReportReason {
  spam
  abuse
  incorrect
  other
}

enum ReportStatus {
  open
  resolved
  dismissed
}

enum FeedbackType {
  bug
  suggestion
  feedback

  @@map("feedback_type")
}

enum FeedbackStatus {
  open
  in_progress
  replied
  resolved
  closed

  @@map("feedback_status")
}

enum FeedbackSenderType {
  user
  admin

  @@map("feedback_sender_type")
}

enum FeedbackAdminAlertStatus {
  pending
  sent
  failed

  @@map("feedback_admin_alert_status")
}

enum AuthCredentialType {
  password
  google
  apple
  passkey
}

enum ProductSource {
  off
  upcitemdb
  user
}

// `pending` predates creator submissions; the expand/classify rollout adds
// `report_hidden|draft|changes_required` without renaming or dropping any existing
// value. Legacy `pending` rows are report-hidden catalog products until the separately
// gated classify migration reclassifies them once creator submission is live.
enum ProductStatus {
  active
  pending
  merged_into
  report_hidden
  draft
  changes_required
}

// `rejected` stays a terminal historical state; ordinary revision moderation only
// reaches `draft|pending|changes_required|approved`.
enum ProductEditStatus {
  pending
  approved
  rejected
  draft
  changes_required

  @@map("product_edit_status")
}

enum ProductPhotoModerationStatus {
  pending
  approved
  rejected

  @@map("product_photo_moderation_status")
}

enum MediaOperationType {
  promote_private
  publish_public
  delete_private
  delete_public
  delete_staged
  enqueue_cleanup

  @@map("media_operation_type")
}

enum MediaOperationStatus {
  prepared
  pending
  processing
  completed
  failed

  @@map("media_operation_status")
}

enum RecordStatus {
  active
  consumed
  discarded
  expired
}

enum PushPlatform {
  ios
  android
}

enum PushLogStatus {
  sent
  failed

  @@map("push_log_status")
}

enum ModerationNotificationEventKind {
  new_product
  product_revision

  @@map("moderation_notification_event_kind")
}

enum ModerationNotificationChannel {
  push
  email

  @@map("moderation_notification_channel")
}

enum ModerationNotificationDeliveryStatus {
  pending
  processing
  sent
  skipped
  failed

  @@map("moderation_notification_delivery_status")
}

enum ModerationNotificationPushAttemptStatus {
  sent
  failed
  invalid

  @@map("moderation_notification_push_attempt_status")
}

model User {
  id                      String          @id @default(uuid()) @db.Uuid
  email                   String          @unique
  emailVerifiedAt         DateTime?
  passwordHash            String?
  firstName               String
  lastName                String
  address                 String?
  country                 String?         @db.Char(2)
  avatarUrl               String?
  role                    UserRole        @default(user)
  status                  UserStatus      @default(active)
  themePreference         ThemePreference @default(expyrico)
  totpSecret              String?
  totpEnabledAt           DateTime?
  tokenVersion            Int             @default(0)
  notificationPreferences Json?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  lastSeenAt              DateTime?
  requireProductApproval  Boolean         @default(false) @map("require_product_approval")

  credentials               AuthCredential[]
  sessions                  Session[]
  pushTokens                PushToken[]
  emailTokens               EmailToken[]
  passwordResets            PasswordReset[]
  totpChallenges            TotpChallenge[]
  totpRecoveryCodes         TotpRecoveryCode[]
  trustedDevices            AdminTrustedDevice[]
  auditLogs                 AdminAuditLog[]     @relation("AuditAdmin")
  products                  Product[]           @relation("ProductCreator")
  productsModerated         Product[]           @relation("ProductModerator")
  records                   Record[]
  productEditsAuthored      ProductEdit[]       @relation("ProductEditAuthor")
  productEditsResolved      ProductEdit[]       @relation("ProductEditResolver")
  productPhotosUploaded     ProductPhoto[]      @relation("ProductPhotoUploader")
  productEditPhotosUploaded ProductEditPhoto[]  @relation("ProductEditPhotoUploader")
  pushLogs                  PushLog[]
  reviews                   Review[]
  reviewVotes               ReviewVote[]
  reportsFiled              Report[]            @relation("ReportReporter")
  reportsResolved           Report[]            @relation("ReportResolver")
  deals                     Deal[]
  dealVotes                 DealVote[]
  giverRatingAvg            Decimal?            @map("giver_rating_avg") @db.Decimal(3, 2)
  recipientRatingAvg        Decimal?            @map("recipient_rating_avg") @db.Decimal(3, 2)
  transactionCount          Int                 @default(0) @map("transaction_count")
  giveaways                 Giveaway[]          @relation("GiveawayGiver")
  giveawayClaims            GiveawayClaim[]     @relation("GiveawayClaimer")
  ratingsGiven              TransactionRating[] @relation("RatingRater")
  ratingsReceived           TransactionRating[] @relation("RatingRatee")
  referralCode              String?             @unique @map("referral_code")
  referredByUserId          String?             @map("referred_by_user_id") @db.Uuid
  referredBy                User?               @relation("UserReferredBy", fields: [referredByUserId], references: [id])
  referredUsers             User[]              @relation("UserReferredBy")
  referralsMade             Referral[]          @relation("ReferralsMade")
  referralReceived          Referral?           @relation("ReferralReceived")
  householdsOwned           Household[]         @relation("HouseholdOwner")
  householdMemberships      HouseholdMember[]

  moderationNotificationDeliveries ModerationNotificationDelivery[]

  feedbackTicketsSubmitted FeedbackTicket[]     @relation("FeedbackAuthor")
  feedbackTicketsResolved  FeedbackTicket[]     @relation("FeedbackResolver")
  feedbackAttachments      FeedbackAttachment[] @relation("FeedbackAttachmentUploader")
  feedbackMessagesSent     FeedbackMessage[]    @relation("FeedbackMessageSender")
  @@map("users")
}

model AuthCredential {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  type           AuthCredentialType
  providerUserId String?
  publicKey      Bytes?
  counter        BigInt?            @default(0)
  metadata       Json?
  createdAt      DateTime           @default(now())
  lastUsedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, providerUserId])
  @@index([userId])
  @@map("auth_credentials")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  deviceInfo       Json?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PushToken {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  deviceToken String       @unique
  platform    PushPlatform
  deviceInfo  Json?
  createdAt   DateTime     @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  moderationNotificationPushAttempts ModerationNotificationPushAttempt[]

  @@index([userId])
  @@map("push_tokens")
}

/// Single-use email verification or login token.
model EmailToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  purpose   String // 'verify_email'
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_tokens")
}

model PasswordReset {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  codeHash        String
  expiresAt       DateTime
  attempts        Int       @default(0)
  verifiedAt      DateTime?
  ticketHash      String?   @unique
  ticketExpiresAt DateTime?
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

/// Short-lived intermediate token issued after a password login when admin TOTP is
/// involved. `purpose` distinguishes a second-factor challenge for an admin who has
/// TOTP enabled ('login') from a forced-enrollment token for an admin who must still
/// set TOTP up ('enroll').
model TotpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  purpose    String    @default("login") // 'login' | 'enroll'
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("totp_challenges")
}

/// One hashed TOTP recovery code per row. Each code is single-use: `usedAt` is
/// stamped when redeemed so the same code can never grant a second session.
model TotpRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("totp_recovery_codes")
}

/// 60-day remembered device registration for an admin. Stored as a SHA-256 hash.
/// A valid, non-revoked row lets an admin bypass OTP challenges on password login.
model AdminTrustedDevice {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  deviceInfo Json?
  ip         String?
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_trusted_devices")
}

model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @db.Uuid
  action     String
  targetType String
  targetId   String
  diff       Json?
  requestId  String?
  ip         String?
  createdAt  DateTime @default(now())

  admin User @relation("AuditAdmin", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
  @@map("admin_audit_log")
}

model Product {
  id                   String        @id @default(uuid()) @db.Uuid
  barcode              String?       @unique
  qrPayload            String?       @unique @map("qr_payload")
  name                 String
  description          String?
  brand                String?
  category             String?
  imageUrl             String?       @map("image_url")
  defaultShelfLifeDays Int?          @map("default_shelf_life_days")
  source               ProductSource
  sourceId             String?       @map("source_id")
  isCommunityEligible  Boolean       @default(false) @map("is_community_eligible")
  buyAgainCount        Int           @default(0) @map("buy_again_count")
  buyAgainOnSaleCount  Int           @default(0) @map("buy_again_on_sale_count")
  wontBuyCount         Int           @default(0) @map("wont_buy_count")
  ratingCount          Int           @default(0) @map("rating_count")
  reviewCount          Int           @default(0) @map("review_count")
  createdByUserId      String?       @map("created_by_user_id") @db.Uuid
  status               ProductStatus @default(active)
  mergedIntoProductId  String?       @map("merged_into_product_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  // Draft/revision lifecycle: optimistic concurrency + caller-visible moderation state.
  version              Int           @default(1)
  moderationNotes      String?       @map("moderation_notes")
  submittedAt          DateTime?     @map("submitted_at")
  moderatedAt          DateTime?     @map("moderated_at")
  moderatedByUserId    String?       @map("moderated_by_user_id") @db.Uuid

  createdBy   User?          @relation("ProductCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  moderatedBy User?          @relation("ProductModerator", fields: [moderatedByUserId], references: [id], onDelete: SetNull)
  mergedInto  Product?       @relation("ProductMerge", fields: [mergedIntoProductId], references: [id], onDelete: SetNull)
  mergedFrom  Product[]      @relation("ProductMerge")
  records     Record[]
  edits       ProductEdit[]
  photos      ProductPhoto[]
  reviews     Review[]
  deals       Deal[]
  giveaways   Giveaway[]

  @@index([source, sourceId])
  @@map("products")
}

model ProductEdit {
  id                 String            @id @default(uuid()) @db.Uuid
  productId          String            @map("product_id") @db.Uuid
  submittedBy        String            @map("submitted_by") @db.Uuid
  proposed           Json
  status             ProductEditStatus @default(pending)
  resolvedBy         String?           @map("resolved_by") @db.Uuid
  resolvedAt         DateTime?         @map("resolved_at")
  notes              String?
  createdAt          DateTime          @default(now()) @map("created_at")
  // Pre-phase-1 backfilled rows have `is_legacy = true` and are exempt from the
  // one-open-edit constraint below so historical pending/approved/rejected history is
  // never invalidated. The column defaults to `false` (migration
  // 20260730052600_default_product_edits_is_legacy_false) so every current and future
  // writer is subject to that constraint unless it explicitly opts out.
  isLegacy           Boolean           @default(false) @map("is_legacy")
  version            Int               @default(1)
  baseProductVersion Int               @default(1) @map("base_product_version")
  moderationNotes    String?           @map("moderation_notes")
  submittedAt        DateTime?         @map("submitted_at")
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at")

  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  submitter User               @relation("ProductEditAuthor", fields: [submittedBy], references: [id])
  resolver  User?              @relation("ProductEditResolver", fields: [resolvedBy], references: [id])
  photos    ProductEditPhoto[]

  @@index([status, createdAt(sort: Desc)])
  @@index([productId])
  // Partial unique index (one open lifecycle edit per creator/product) is created in
  // migration.sql — Prisma cannot express a partial index in this schema syntax.
  @@map("product_edits")
}

/// Ordered, immutable-once-published photos on a live/draft product. Position 0 is
/// cover. Exactly one of `privateStorageKey` (pre-publication) or `publicStorageKey`
/// (post-publication) is set at a time, enforced by a DB check tied to
/// `moderationStatus` (migration.sql — Prisma cannot express this check).
model ProductPhoto {
  id                String                       @id @default(uuid()) @db.Uuid
  productId         String                       @map("product_id") @db.Uuid
  position          Int
  uploadedByUserId  String                       @map("uploaded_by_user_id") @db.Uuid
  moderationStatus  ProductPhotoModerationStatus @default(pending) @map("moderation_status")
  moderationNote    String?                      @map("moderation_note")
  privateStorageKey String?                      @map("private_storage_key")
  publicStorageKey  String?                      @map("public_storage_key")
  mimeType          String                       @map("mime_type")
  displayByteSize   Int                          @map("display_byte_size")
  displayWidth      Int                          @map("display_width")
  displayHeight     Int                          @map("display_height")
  thumbnailByteSize Int                          @map("thumbnail_byte_size")
  thumbnailWidth    Int                          @map("thumbnail_width")
  thumbnailHeight   Int                          @map("thumbnail_height")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @default(now()) @updatedAt @map("updated_at")

  product         Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadedBy      User               @relation("ProductPhotoUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  retainedByEdits ProductEditPhoto[] @relation("ProductEditPhotoSource")

  // DEFERRABLE INITIALLY IMMEDIATE in migration.sql (Prisma cannot express deferrable
  // constraints) so a reorder transaction can `SET CONSTRAINTS ... DEFERRED` and write
  // the whole target position order in one statement, checked only at commit.
  @@unique([productId, position])
  @@map("product_photos")
}

/// One entry per desired position in an edit's proposed photo set: either a retained
/// live photo (`sourceProductPhotoId` set, no staged fields) or newly staged media (all
/// staged fields set, no source). The XOR is enforced by a DB check in migration.sql.
model ProductEditPhoto {
  id                   String   @id @default(uuid()) @db.Uuid
  productEditId        String   @map("product_edit_id") @db.Uuid
  position             Int
  sourceProductPhotoId String?  @map("source_product_photo_id") @db.Uuid
  uploadedByUserId     String?  @map("uploaded_by_user_id") @db.Uuid
  privateStorageKey    String?  @map("private_storage_key")
  mimeType             String?  @map("mime_type")
  displayByteSize      Int?     @map("display_byte_size")
  displayWidth         Int?     @map("display_width")
  displayHeight        Int?     @map("display_height")
  thumbnailByteSize    Int?     @map("thumbnail_byte_size")
  thumbnailWidth       Int?     @map("thumbnail_width")
  thumbnailHeight      Int?     @map("thumbnail_height")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  productEdit        ProductEdit   @relation(fields: [productEditId], references: [id], onDelete: Cascade)
  sourceProductPhoto ProductPhoto? @relation("ProductEditPhotoSource", fields: [sourceProductPhotoId], references: [id], onDelete: Restrict)
  uploadedBy         User?         @relation("ProductEditPhotoUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  // DEFERRABLE INITIALLY IMMEDIATE in migration.sql — see ProductPhoto's matching note.
  @@unique([productEditId, position])
  @@map("product_edit_photos")
}

/// Durable DB/filesystem handoff for private-promotion and public-publish media
/// operations. A `prepared` intent with a renewable lease is committed before any final
/// rename/copy; the reference-changing transaction completes it atomically. Workers
/// claim expired `prepared` or ready `pending` cleanup rows with `FOR UPDATE SKIP
/// LOCKED` via the partial indexes below.
model MediaOperationOutbox {
  id             String               @id @default(uuid()) @db.Uuid
  operation      MediaOperationType
  /// `{ keys: string[] }` — validated by a DB check in migration.sql.
  payload        Json
  status         MediaOperationStatus @default(pending)
  leaseOwner     String?              @map("lease_owner")
  leaseExpiresAt DateTime?            @map("lease_expires_at")
  attempts       Int                  @default(0)
  availableAt    DateTime             @default(now()) @map("available_at")
  lastError      String?              @map("last_error")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at")

  @@map("media_operation_outbox")
}

/// One successful transition occurrence of a product or edit into `pending`.
/// `sourceId` references a product or edit by `kind` but carries no Prisma relation:
/// the notification pipeline must outlive the source row. The post-transition
/// `submissionVersion` makes a resubmission or rebase a new event while the same
/// guarded transition can never double-record. `batchId` is null until a batch tick
/// claims the event.
model ModerationNotificationEvent {
  id                String                          @id @default(uuid()) @db.Uuid
  kind              ModerationNotificationEventKind
  sourceId          String                          @map("source_id") @db.Uuid
  submissionVersion Int                             @map("submission_version")
  submittedAt       DateTime                        @map("submitted_at")
  batchId           String?                         @map("batch_id") @db.Uuid
  createdAt         DateTime                        @default(now()) @map("created_at")

  batch ModerationNotificationBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([kind, sourceId, submissionVersion])
  // The migration owns a partial `batch_id IS NULL` claim index; Prisma schema
  // syntax cannot express partial indexes.
  @@map("moderation_notification_events")
}

model ModerationNotificationBatch {
  id              String   @id @default(uuid()) @db.Uuid
  windowStart     DateTime @map("window_start")
  windowEnd       DateTime @map("window_end")
  newProductCount Int      @default(0) @map("new_product_count")
  revisionCount   Int      @default(0) @map("revision_count")
  recipientCount  Int      @default(0) @map("recipient_count")
  createdAt       DateTime @default(now()) @map("created_at")

  events     ModerationNotificationEvent[]
  deliveries ModerationNotificationDelivery[]

  @@index([createdAt(sort: Desc)])
  @@map("moderation_notification_batches")
}

/// Singleton durable operational state for the moderation pipeline. Counters are
/// intentionally aggregate-only; the history tables remain the source for batch
/// and per-channel detail.
model ModerationNotificationHealth {
  id                            String    @id
  lastSuccessfulTickAt          DateTime? @map("last_successful_tick_at")
  lastRecoveryAt                DateTime? @map("last_recovery_at")
  lastSchedulerReconciliationAt DateTime? @map("last_scheduler_reconciliation_at")
  lastCleanupAt                 DateTime? @map("last_cleanup_at")
  lastZeroRecipientBatchAt      DateTime? @map("last_zero_recipient_batch_at")
  terminalFailureCount          Int       @default(0) @map("terminal_failure_count")
  deletedBatchCount             Int       @default(0) @map("deleted_batch_count")
  updatedAt                     DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("moderation_notification_health")
}

/// One recipient x channel delivery for a batch. Claim/renew/finalize updates are
/// fenced by `(id, status, leaseOwner)` so a worker that lost its lease cannot
/// overwrite later state. `completedAt` is set on every terminal transition
/// (`sent|skipped|failed`). No destination email or token value is stored here.
model ModerationNotificationDelivery {
  id                String                                @id @default(uuid()) @db.Uuid
  batchId           String                                @map("batch_id") @db.Uuid
  recipientUserId   String                                @map("recipient_user_id") @db.Uuid
  channel           ModerationNotificationChannel
  status            ModerationNotificationDeliveryStatus  @default(pending)
  attempts          Int                                   @default(0)
  availableAt       DateTime                              @default(now()) @map("available_at")
  leaseOwner        String?                               @map("lease_owner")
  leaseExpiresAt    DateTime?                             @map("lease_expires_at")
  completedAt       DateTime?                             @map("completed_at")
  providerMessageId String?                               @map("provider_message_id")
  errorMessage      String?                               @map("error_message")
  createdAt         DateTime                              @default(now()) @map("created_at")
  updatedAt         DateTime                              @default(now()) @updatedAt @map("updated_at")

  batch         ModerationNotificationBatch         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  recipient     User                                @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  pushAttempts  ModerationNotificationPushAttempt[]

  @@unique([batchId, recipientUserId, channel])
  // The migration owns partial due-work and batch-history indexes; Prisma schema
  // syntax cannot express their status predicates.
  @@map("moderation_notification_deliveries")
}

/// Durable per-token outcome for one FCM attempt of a push delivery, so a failed or
/// invalid token never forces a retry of a sibling token that already accepted.
model ModerationNotificationPushAttempt {
  id                String                                     @id @default(uuid()) @db.Uuid
  deliveryId        String                                     @map("delivery_id") @db.Uuid
  pushTokenId       String                                     @map("push_token_id") @db.Uuid
  attemptNumber     Int                                        @map("attempt_number")
  status            ModerationNotificationPushAttemptStatus
  providerMessageId String?                                    @map("provider_message_id")
  errorMessage      String?                                    @map("error_message")
  createdAt         DateTime                                   @default(now()) @map("created_at")

  delivery  ModerationNotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  pushToken PushToken                      @relation(fields: [pushTokenId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, pushTokenId, attemptNumber])
  @@index([deliveryId])
  @@map("moderation_notification_push_attempts")
}

model Record {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  productId    String?      @map("product_id") @db.Uuid
  customName   String?      @map("custom_name")
  category     String?
  expiryDate   DateTime     @map("expiry_date") @db.Date
  purchaseDate DateTime?    @map("purchase_date") @db.Date
  quantity     Decimal      @default(1) @db.Decimal(12, 3)
  unit         String       @default("pcs")
  price        Decimal?     @db.Decimal(10, 2)
  store        String?
  notes        String?
  photoUrl     String?      @map("photo_url")
  status       RecordStatus @default(active)
  notifyAt     Json         @default("[]") @map("notify_at")
  clientId     String       @unique @map("client_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  consumedAt   DateTime?    @map("consumed_at")
  householdId  String?      @map("household_id") @db.Uuid

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  pushLogs  PushLog[]
  giveaways Giveaway[]
  household Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@index([userId, status, expiryDate])
  @@index([householdId, status, expiryDate])
  @@index([householdId, updatedAt])
  @@map("records")
}

model PushLog {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  recordId          String?       @map("record_id") @db.Uuid
  providerMessageId String?       @map("provider_message_id")
  templateKey       String        @map("template_key")
  status            PushLogStatus
  errorMessage      String?       @map("error_message")
  createdAt         DateTime      @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  record Record? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("push_logs")
}

model Review {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  productId       String       @map("product_id") @db.Uuid
  rating          ReviewRating
  body            String?
  helpfulCount    Int          @default(0) @map("helpful_count")
  notHelpfulCount Int          @default(0) @map("not_helpful_count")
  score           Decimal      @default(0) @db.Decimal(7, 6)
  status          ReviewStatus @default(visible)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  votes   ReviewVote[]

  @@unique([userId, productId])
  @@index([productId, status, score(sort: Desc)])
  @@map("reviews")
}

model ReviewVote {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  value     String // 'helpful' | 'not_helpful'
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@map("review_votes")
}

model Report {
  id                String           @id @default(uuid()) @db.Uuid
  reporterId        String           @map("reporter_id") @db.Uuid
  targetType        ReportTargetType @map("target_type")
  targetId          String           @map("target_id") @db.Uuid
  reason            ReportReason
  body              String?
  status            ReportStatus     @default(open)
  resolvedByAdminId String?          @map("resolved_by_admin_id") @db.Uuid
  resolvedAt        DateTime?        @map("resolved_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  reporter        User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedByAdmin User? @relation("ReportResolver", fields: [resolvedByAdminId], references: [id])

  @@index([targetType, targetId, status])
  @@index([status, createdAt])
  @@map("reports")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@map("settings")
}

model NotificationTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  title     String
  body      String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@map("notification_templates")
}

model ApiError {
  id        String   @id @default(uuid()) @db.Uuid
  route     String
  method    String
  status    Int
  code      String?
  message   String?
  requestId String?  @map("request_id")
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([route, status])
  @@map("api_errors")
}

enum DealStatus {
  visible
  hidden
  deleted

  @@map("deal_status")
}

model Deal {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  productId     String     @map("product_id") @db.Uuid
  price         Decimal    @db.Decimal(10, 2)
  currency      String     @db.Char(3)
  storeName     String     @map("store_name")
  photoUrl      String?    @map("photo_url")
  expiryDate    DateTime?  @map("expiry_date") @db.Date
  note          String?
  country       String?    @db.Char(2)
  upvoteCount   Int        @default(0) @map("upvote_count")
  downvoteCount Int        @default(0) @map("downvote_count")
  score         Decimal    @default(0) @db.Decimal(7, 6)
  status        DealStatus @default(visible)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  votes   DealVote[]

  @@index([status, score(sort: Desc), createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([country, status, score(sort: Desc), createdAt(sort: Desc)])
  @@index([productId])
  @@map("deals")
}

model DealVote {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  dealId    String   @map("deal_id") @db.Uuid
  value     Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([userId, dealId])
  @@index([dealId])
  @@map("deal_votes")
}

enum GiveawayStatus {
  open
  claimed
  handed_off
  completed
  cancelled

  @@map("giveaway_status")
}

enum GiveawayClaimStatus {
  requested
  selected
  rejected

  @@map("giveaway_claim_status")
}

enum TransactionRaterRole {
  giver
  recipient

  @@map("transaction_rater_role")
}

model Giveaway {
  id             String         @id @default(uuid()) @db.Uuid
  giverUserId    String         @map("giver_user_id") @db.Uuid
  productId      String?        @map("product_id") @db.Uuid
  recordId       String?        @map("record_id") @db.Uuid
  title          String
  description    String?
  photoUrl       String?        @map("photo_url")
  locationText   String         @map("location_text")
  country        String?        @db.Char(2)
  status         GiveawayStatus @default(open)
  quantity       Float          @default(1)
  unit           String         @default("pcs") @db.VarChar(16)
  expiryDate     String?        @map("expiry_date")
  claimExpiresAt DateTime?      @map("claim_expires_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  handedOffAt    DateTime?      @map("handed_off_at")
  confirmedAt    DateTime?      @map("confirmed_at")
  completedAt    DateTime?      @map("completed_at")
  giver   User                @relation("GiveawayGiver", fields: [giverUserId], references: [id], onDelete: Cascade)
  product Product?            @relation(fields: [productId], references: [id])
  record  Record?             @relation(fields: [recordId], references: [id])
  claims  GiveawayClaim[]
  ratings TransactionRating[]

  @@index([country, status, createdAt(sort: Desc)])
  @@index([giverUserId, status])
  @@index([status, claimExpiresAt])
  @@map("giveaways")
}

model GiveawayClaim {
  id            String              @id @default(uuid()) @db.Uuid
  giveawayId    String              @map("giveaway_id") @db.Uuid
  claimerUserId String              @map("claimer_user_id") @db.Uuid
  pickupNote    String?             @map("pickup_note")
  status        GiveawayClaimStatus @default(requested)
  createdAt     DateTime            @default(now()) @map("created_at")

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  claimer  User     @relation("GiveawayClaimer", fields: [claimerUserId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, claimerUserId])
  @@index([giveawayId, status])
  @@map("giveaway_claims")
}

model TransactionRating {
  id          String               @id @default(uuid()) @db.Uuid
  giveawayId  String               @map("giveaway_id") @db.Uuid
  raterUserId String               @map("rater_user_id") @db.Uuid
  rateeUserId String               @map("ratee_user_id") @db.Uuid
  raterRole   TransactionRaterRole @map("rater_role")
  stars       Int                  @db.SmallInt
  comment     String?
  revealedAt  DateTime?            @map("revealed_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  rater    User     @relation("RatingRater", fields: [raterUserId], references: [id], onDelete: Cascade)
  ratee    User     @relation("RatingRatee", fields: [rateeUserId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, raterUserId])
  @@index([rateeUserId])
  @@map("transaction_ratings")
}

model NotificationOutbox {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  templateKey  String    @map("template_key")
  payload      Json
  dispatchedAt DateTime? @map("dispatched_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([dispatchedAt, createdAt])
  @@map("notification_outbox")
}

enum ReferralStatus {
  pending
  activated

  @@map("referral_status")
}

model Referral {
  id             String         @id @default(uuid()) @db.Uuid
  referrerUserId String         @map("referrer_user_id") @db.Uuid
  referredUserId String         @unique @map("referred_user_id") @db.Uuid
  referralCode   String         @map("referral_code")
  status         ReferralStatus @default(pending)
  signupIp       String?        @map("signup_ip")
  activatedAt    DateTime?      @map("activated_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  referrer User @relation("ReferralsMade", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralReceived", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId, status])
  @@map("referrals")
}

enum HouseholdRole {
  owner
  member

  @@map("household_role")
}

model Household {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  ownerUserId String   @map("owner_user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner   User              @relation("HouseholdOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members HouseholdMember[]
  records Record[]

  @@index([ownerUserId])
  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(uuid()) @db.Uuid
  householdId String        @map("household_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        HouseholdRole @default(member)
  joinedAt    DateTime      @default(now()) @map("joined_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

model FeedbackTicket {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  type            FeedbackType
  title           String
  description     String
  status          FeedbackStatus @default(open)
  deviceInfo      Json?          @map("device_info")
  resolvedAt      DateTime?      @map("resolved_at")
  resolvedBy      String?        @map("resolved_by") @db.Uuid
  resolutionNotes String?        @map("resolution_notes")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user        User                 @relation("FeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)
  resolver    User?                @relation("FeedbackResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  attachments FeedbackAttachment[]
  messages    FeedbackMessage[]
  adminAlerts FeedbackAdminAlertOutbox[]

  @@index([userId, createdAt])
  @@index([status, type, createdAt])
  @@map("feedback_tickets")
}

model FeedbackAttachment {
  id            String   @id @default(uuid()) @db.Uuid
  ticketId      String?  @map("ticket_id") @db.Uuid
  uploaderId    String   @map("uploader_id") @db.Uuid
  fileName      String   @map("file_name")
  mimeType      String   @map("mime_type")
  fileSizeBytes Int      @map("file_size_bytes")
  storageKey    String   @map("storage_key")
  createdAt     DateTime @default(now()) @map("created_at")

  ticket   FeedbackTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploader User            @relation("FeedbackAttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([uploaderId])
  @@map("feedback_attachments")
}

model FeedbackMessage {
  id           String             @id @default(uuid()) @db.Uuid
  ticketId     String             @map("ticket_id") @db.Uuid
  senderType   FeedbackSenderType @map("sender_type")
  senderUserId String             @map("sender_user_id") @db.Uuid
  message      String
  createdAt    DateTime           @default(now()) @map("created_at")

  ticket     FeedbackTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUser User           @relation("FeedbackMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("feedback_messages")
}

model FeedbackAdminAlertOutbox {
  id           String                   @id @default(uuid()) @db.Uuid
  ticketId     String                   @map("ticket_id") @db.Uuid
  status       FeedbackAdminAlertStatus @default(pending)
  attempts     Int                      @default(0)
  dispatchedAt DateTime?                @map("dispatched_at")
  lastError    String?                  @map("last_error")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  ticket       FeedbackTicket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([ticketId])
  @@map("feedback_admin_alert_outbox")
}
